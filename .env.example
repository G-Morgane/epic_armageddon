SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publique de l'environnement. Non définie = prod (www.epicarmageddon.fr).
# Staging : https://staging.epicarmageddon.fr
# Pilote le sitemap, l'URL de retour des liens de connexion, et l'indexation :
# tout ce qui n'est pas l'URL de prod est servi en noindex.
NUXT_PUBLIC_SITE_URL=

# Archive des binaires Chromium pour la génération de PDF en production.
# Vide = servie par R2 (voir scripts/publier-pack-chromium.ts). À ne remplir
# que pour pointer ailleurs.
CHROMIUM_PACK_URL=
